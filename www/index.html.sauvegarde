<!DOCTYPE html>
<html lang="fr">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CitaPlus</title>

<link rel="stylesheet" href="style.css">
</head>
<body>
  <button class="settings" onclick="ouvrirParametres()">
    ⚙️
  </button>
<button id="boutonRetourGlobal" onclick="retourGlobal()">
    &lt; RETOUR
</button>
<!-- COMPTEUR DE POINTS -->
<div id="compteurPoints">
    🪙 <span id="points">20</span>
    <button id="btnPoints" onclick="ouvrirPoints()">➕</button>
</div>


<!-- SPLASH -->
<div id="splash">

    <div class="app-icon">📖</div>

    <h1>CitaPlus</h1>

    <p>Une citation pour bien commencer la journée.</p>

</div>



<!-- ACCUEIL -->
<section id="accueil" class="page">

    <div class="app-icon">📖</div>

    <h1>CitaPlus</h1>

    <p class="slogan">
        Une citation pour bien commencer la journée.
    </p>

    <div class="bienvenue">

        <p>
            Découvrez la sagesse des philosophes,
            la motivation et l'inspiration chaque jour.
        </p>

    </div>

    <button onclick="ouvrirMenu()">
        Commencer
    </button>
  <button id="boutonPremium" onclick="ouvrirPoints()">
    ⭐ Premium
  </button>
</section>


<!-- MENU -->
<section id="menu" class="page cache">

    <h1>CitaPlus</h1>

    <button onclick="ouvrirPhilosophes()">
        🏛️ Philosophes
    </button>

    <button onclick="ouvrirPopulaires()">
        🌟 Populaires
    </button>

    <button onclick="ouvrirQuiz()">
        🧠 Quiz
    </button>

</section>


<!-- PHILOSOPHES -->
<section id="philosophes" class="page cache">

    <h1>🏛️ Philosophes</h1>

    <p>
        Choisis un philosophe pour découvrir ses citations.
    </p>

    <!-- Les philosophes seront ajoutés automatiquement -->
    <div id="listePhilosophes"></div>

</section>


<!-- LISTE DES CITATIONS D'UN PHILOSOPHE -->
<section id="listeCitations" class="page cache">


    <h1 id="titreListeCitations">
        Citations
    </h1>

    <div id="listeCitationsContainer"></div>

</section>


<!-- LECTEUR DE CITATION -->
<section id="lecture" class="page cache">

    <div class="citation-box">

        <p id="citationTexte">
            Citation
        </p>

        <h3 id="auteur">
            Auteur
        </h3>

        <div class="actions-citation">

            <button onclick="ajouterFavori()">
                ❤️
            </button>

            <button onclick="copierCitation()">
                📋
            </button>

        </div>

    </div>


    <div class="navigation-citation">

        <button onclick="citationPrecedente()">
            ⬅️ Précédente
        </button>

        <button onclick="citationSuivante()">
            Suivante ➡️
        </button>

    </div>




</section>


<!-- POPULAIRES -->
<section id="populaires" class="page cache">

    <h1>🌟 Citations populaires</h1>

    <button onclick="choisirCategorie('amour')">
        ❤️ Amour
    </button>

    <button onclick="choisirCategorie('motivation')">
        💪 Motivation
    </button>

    <button onclick="choisirCategorie('reussite')">
        💰 Réussite
    </button>

    <button onclick="choisirCategorie('foi')">
        🙏 Foi
    </button>

    <button onclick="choisirCategorie('bonheur')">
        😊 Bonheur
    </button>

    <button onclick="choisirCategorie('sagesse')">
        📚 Sagesse
    </button>

    <button onclick="choisirCategorie('humour')">
        😂 Humour
    </button>

</section>


<!-- QUIZ -->
<section id="quiz" class="page cache">

    <h1>🧠 Quiz</h1>

    <p id="question">
        Question
    </p>

    <button onclick="reponse1()">
        Réponse 1
    </button>

    <button onclick="reponse2()">
        Réponse 2
    </button>

    <button onclick="reponse3()">
        Réponse 3
    </button>

    <p id="resultat"></p>

</section>


<!-- PARAMÈTRES -->
<section id="parametres" class="page cache">

    <h1>⚙️ Paramètres</h1>

    <button onclick="modeSombre()">
        🌙 Mode sombre
    </button>

    <button onclick="ouvrirFavoris()">
        ⭐ Mes favoris
    </button>

    <button onclick="partagerApplication()">
        📤 Partager l'application
    </button>

    <button onclick="ouvrirMiseAJour()">
        📥 Vérifier les mises à jour
    </button>

    <button onclick="ouvrirApropos()">
        ℹ️ À propos
    </button>

    <p>
        Développé par : K. ARSENE
    </p>

</section>


<!-- À PROPOS -->
<section id="apropos" class="page cache">


    <h1>ℹ️ À propos</h1>

    <div class="citation-box">

        <h2>CitaPlus</h2>

        <p><b>Version :</b> 2.0</p>

        <p>
            <b>Slogan :</b><br>
            Une citation pour bien commencer la journée.
        </p>

        <p>
            CitaPlus permet de découvrir des citations
            de philosophes et des citations populaires,
            même sans connexion Internet.
        </p>

        <p>
            Notre objectif est d'inspirer, motiver et
            partager la sagesse.
        </p>

        <p>
            Développé par ARSENE KOUADIO
        </p>

        <p>
            <b>Merci d'utiliser CitaPlus ❤️</b>
        </p>

    </div>

</section>


<!-- MISE À JOUR -->
<section id="miseajour" class="page cache">

    <h1>🔄 Mise à jour</h1>

    <div class="citation-box">

        <h2>CitaPlus Version 2.0</h2>

        <p>✅ Citations de philosophes</p>
        <p>✅ Citations populaires</p>
        <p>✅ Mode sombre</p>
        <p>✅ Système de favoris</p>
        <p>✅ Système de points</p>

        <br>

        <h2>Prochainement</h2>

        <p>⭐ Plus de philosophes</p>
        <p>⭐ Plus de citations</p>
        <p>⭐ Récompenses vidéo</p>
        <p>⭐ Améliorations</p>

    </div>

</section>


<!-- FAVORIS -->
<section id="favoris" class="page cache">


    <h1>⭐ Mes favoris</h1>

    <div id="listeFavoris"></div>

</section>


<!-- BARRE DE NAVIGATION -->
<nav class="navigation">

    <button onclick="ouvrirPhilosophes()">
        🏛️
    </button>

    <button onclick="ouvrirPopulaires()">
        🌟
    </button>

    <button onclick="ouvrirQuiz()">
        🧠
    </button>

    <button onclick="ouvrirFavoris()">
        ⭐
    </button>

</nav>


<!-- NOTIFICATION -->
<div id="notification"></div>


<!-- MODALE DE VERROUILLAGE -->


<script>
console.log("CitaPlus : JavaScript chargé");
</script>
<script src="citations.js"></script>
<script src="script.js"></script>

</body>
</html>